# Copier vers .env (ne jamais committer .env)
#   copy .env.example .env   (PowerShell)
#   cp .env.example .env     (bash)

# --- Environnement applicatif ---
# development | production
# En production : /docs, /redoc, /openapi.json désactivés
APP_ENV=development

# --- PostgreSQL / PostGIS ---
# Compose : DB_HOST=db (service docker)
# Dev local Windows avec Postgres installé : DB_HOST=localhost
# Conteneur backend -> Postgres hôte : DB_HOST=host.docker.internal
DB_HOST=db
DB_PORT=5432
DB_NAME=mobilite
DB_USER=mobilite
# Mot de passe : à changer hors machine personnelle / démo contrôlée
DB_PASSWORD=mobilite_change_me

# --- API ---
# Origines CORS autorisées (séparées par des virgules). Ne jamais mettre *
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173

# --- Frontend (build Docker) ---
# URL appelée par le navigateur vers l'API
VITE_API_URL=http://localhost:8000
